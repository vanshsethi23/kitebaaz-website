/**
 * KITEBAAZ — rooftop subscribe backend (Google Apps Script web app).
 *
 * What it does on each POST from the site:
 *   1. Validates the email.
 *   2. Logs it to the bound Google Sheet (tab "Subscribers"),
 *      deduplicating repeat sign-ups.
 *   3. Sends the branded welcome email from this Google account
 *      (deploy while logged in as kitebaaz.in@gmail.com).
 *   4. Returns JSON the site's form handler understands:
 *      { ok: true } | { ok: true, already: true } | { ok: false, error: "..." }
 *
 * Deploy: Extensions → Apps Script inside the Sheet, paste this file,
 * then Deploy → New deployment → Web app → execute as "Me",
 * access "Anyone". Put the /exec URL into data-endpoint on the site form.
 */

var SHEET_NAME = 'Subscribers';
var FROM_NAME = 'KITEBAAZ';
var SUBJECT = 'You’re on the rooftop.';

/* Ink-on-paper lockup, base64-embedded so the email needs no externally
   hosted asset (sent as a CID inline image, referenced as cid:kbLogo below). */
var LOGO_BASE64 = '';

function doPost(e) {
  var lock = LockService.getScriptLock();
  lock.tryLock(5000);
  try {
    var email = String((e && e.parameter && e.parameter.email) || '').trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      return json_({ ok: false, error: 'invalid-email' });
    }

    var sheet = getSheet_();
    var last = sheet.getLastRow();
    if (last > 1) {
      var existing = sheet.getRange(2, 2, last - 1, 1).getValues();
      for (var i = 0; i < existing.length; i++) {
        if (String(existing[i][0]).toLowerCase() === email) {
          return json_({ ok: true, already: true }); // already on the list; no duplicate email
        }
      }
    }

    sheet.appendRow([new Date(), email, 'website', 'welcomed']);
    sendWelcome_(email);
    return json_({ ok: true });
  } catch (err) {
    return json_({ ok: false, error: String(err) });
  } finally {
    try { lock.releaseLock(); } catch (_) {}
  }
}

/** Quick health check in the browser: open the /exec URL directly. */
function doGet() {
  return json_({ ok: true, service: 'kitebaaz-rooftop' });
}

function getSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(SHEET_NAME);
    sheet.appendRow(['Timestamp', 'Email', 'Source', 'Status']);
    sheet.setFrozenRows(1);
  }
  return sheet;
}

function sendWelcome_(email) {
  var logoBlob = Utilities.newBlob(Utilities.base64Decode(LOGO_BASE64), 'image/png', 'kitebaaz-logo.png');
  GmailApp.sendEmail(email, SUBJECT, plainBody_(), {
    htmlBody: htmlBody_(),
    name: FROM_NAME,
    replyTo: 'kitebaaz.in@gmail.com',
    inlineImages: { kbLogo: logoBlob }
  });
}

/** Send yourself a test copy: run this function from the editor. */
function testWelcome() {
  sendWelcome_(Session.getActiveUser().getEmail());
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

